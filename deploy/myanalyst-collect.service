[Unit]
Description=myAnalyst - collect NSE closes and CBK key rates
Documentation=https://github.com/bgachichio/myAnalyst/blob/main/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=myanalyst
Group=myanalyst

# Read by PID 1 before the sandbox below applies, so ProtectHome=true is fine.
EnvironmentFile=/home/myanalyst/secrets/myanalyst.env

# Through the release symlink, never a fixed release, so rollback.sh actually
# changes what runs.
ExecStart=/opt/myanalyst/current/.venv/bin/myanalyst-collect \
  --db ${MYANALYST_DB} --out ${MYANALYST_OUT} --window ${MYANALYST_WINDOW_DAYS}

# ---------------------------------------------------------------- isolation
# This box also runs the website and Kenya Pulse. The collector must be unable
# to touch either, and must lose every contest for resources rather than win it.

# Filesystem: read-only everywhere, writable in exactly two directories.
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/myanalyst /srv/myanalyst
PrivateTmp=true
ProtectProc=invisible
ProcSubset=pid

# Privilege: none, and none obtainable.
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Network: outbound HTTPS only. It listens on nothing, so it can never collide
# with Caddy, Kenya Pulse, or any port already in use.
RestrictAddressFamilies=AF_INET AF_INET6
IPAddressDeny=link-local multicast

# Resources: a hard ceiling, a soft throttle above the measured peak, and last
# place in every queue. On a 1 GB box the kernel must kill this before it kills
# a web service.
#
# Measured, not guessed: one daily run - scrape the page, parse 65 counters,
# append, record the key rates, prune and emit, against a store holding 26,001
# closes - peaks at 32 MB RSS and 986 KB on disk. It was 132 MB on DuckDB;
# plain JSON is the right rung for this much data and cost four times less.
#
# This is a oneshot, not a resident service: it adds no standing memory to the
# box, only a few seconds' spike, six days a week.
MemoryHigh=64M
MemoryMax=128M
CPUQuota=40%
CPUWeight=20
IOWeight=20
Nice=10
OOMScoreAdjust=800
TasksMax=32
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
