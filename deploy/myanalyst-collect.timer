[Unit]
Description=Collect NSE closes after the market settles

[Timer]
# The NSE trades 09:00-15:00 EAT. 18:00 EAT is 15:00 UTC, well after the close
# and after the day's price list is published. Weekdays only; a public holiday
# simply yields no new list, which the run reports rather than treats as failure.
OnCalendar=Mon..Fri *-*-* 15:00:00 UTC
RandomizedDelaySec=600
Persistent=true

[Install]
WantedBy=timers.target
