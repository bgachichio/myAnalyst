# Names only. Never values. Real secrets live in ~/secrets/myanalyst.env, mode 600.

# --- the collector, on the VM -------------------------------------------------
# A directory of JSON files, one per counter. Not a database file: DuckDB was
# dropped as over-specified, which cut memory four times and disk three.
MYANALYST_DB=/var/lib/myanalyst/store
MYANALYST_OUT=/srv/myanalyst/private
MYANALYST_WINDOW_DAYS=400
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- the machine you deploy from ---------------------------------------------
# The ssh host for the VM, if it is not called `pulse` in your ~/.ssh/config.
MYANALYST_HOST=
# The site password in plaintext, so deploy-app.sh can verify the site answers.
# The VM holds only the hash, in /etc/caddy/env. Set this per shell rather than
# storing it: `read -rs MYANALYST_PASSWORD && export MYANALYST_PASSWORD`
MYANALYST_PASSWORD=
# Only if Playwright's browser lives somewhere its own resolution cannot find.
PLAYWRIGHT_CHROMIUM_PATH=
